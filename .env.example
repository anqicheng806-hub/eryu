# Non-secret Windows Reader configuration. Copy to .env if useful.
# Do not store ERYU_PRESENCE_TOKEN or ERYU_AUTH_TOKEN in this file.

# Direct-HTTPS mode only: use the Eryu Web base URL, without /music/presence.
# Leave empty when using start_windows_reader.ps1 -SshTunnel.
ERYU_PRESENCE_ENDPOINT=

# Optional non-secret username when the Eryu Web host is behind Caddy Basic Auth.
ERYU_PRESENCE_BASIC_AUTH_USER=

# The server TTL is 10 seconds; keep the heartbeat comfortably below it.
ERYU_PRESENCE_HEARTBEAT_SECONDS=2

# Comma-separated, case-insensitive SourceAppUserModelId substrings.
ERYU_GSMTC_PLAYER_PREFERENCES=cloudmusic,netease,spotify

# Optional extra sources to ignore in addition to the built-in system-shell list.
ERYU_GSMTC_IGNORED_SOURCES=

# ERYU_PRESENCE_TOKEN is the full Eryu Web token used for POST /music/presence.
# The PowerShell launcher asks for it with masked input and passes it only to
# the Reader child process. ERYU_MCP_READ_TOKEN cannot write presence.
# If ERYU_PRESENCE_BASIC_AUTH_USER is set, the launcher also asks for the Basic
# Auth password and passes ERYU_PRESENCE_BASIC_AUTH_PASSWORD process-only.
